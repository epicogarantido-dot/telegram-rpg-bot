{
  "name": "aprenda-livre",
  "private": true,
  "description": "Cursos gratuitos e abertos do mundo inteiro, traduzidos para português — site + bot de WhatsApp.",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "engines": { "node": ">=22" },
  "scripts": {
    "dev:site": "npm run dev -w @aprenda/site",
    "build:site": "npm run build -w @aprenda/site",
    "bot": "npm run start -w @aprenda/bot",
    "ingerir": "npm run ingerir -w @aprenda/ingestao --",
    "traduzir": "npm run traduzir -w @aprenda/ingestao --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
