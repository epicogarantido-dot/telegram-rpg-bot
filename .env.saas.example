# Modelo de .env do app SaaS: o que é ENTREGUE a quem já pagou (site de cada barbearia, agenda,
# painel do barbeiro e renovações). Não tem venda nem link pro site de leads: a compra acontece lá,
# e o app de leads manda a barbearia pra cá quando o admin confirma o 1º Pix.
# Copie pra .env no app das barbearias na Square. O zip já vem com MODO_SITE=saas.

# Endereço DESTE app
SITE_URL=https://sitedabarbearia.squareweb.app

# Senha do admin (/painel/assinaturas). Tem que ser a MESMA do app de leads: é dela que sai a
# chave que o de leads usa pra entregar as barbearias aqui.
PAINEL_SENHA=

# Renovações: Pix estático com confirmação manual do admin em /painel/assinaturas deste app
PIX_CHAVE=
PIX_NOME=Seu Nome
PIX_CIDADE=Sua Cidade
ADMIN_WHATSAPP=5511999999999
# Mensalidade em reais, a cada PLANO_DIAS dias (a contratação é cobrada no app de leads)
PLANO_VALOR=50
PLANO_DIAS=30

# Avisos no celular do barbeiro (opcional: sem isso, as chaves são geradas e guardadas no banco)
VAPID_PUBLICA=
VAPID_PRIVADA=
