# Modelo de .env do app SaaS (site de cada barbearia, agenda, painel do barbeiro e pagamentos).
# Copie pra .env no app das barbearias na Square. O zip já vem com MODO_SITE=saas.

# Endereço DESTE app e do app de leads (cursos, Revista, /barbeiros)
SITE_URL=https://sitedabarbearia.squareweb.app
LEADS_URL=https://barbearias777.squareweb.app

# A MESMA senha do app de leads (os dois apps se falam com uma chave tirada dela)
PAINEL_SENHA=

# Qual site de exemplo abre no endereço principal deste app:
# silencioso, atemporal, cerimonia, tecnico, potencia ou extravagancia. Padrão: cerimonia.
# SITE_INICIAL=cerimonia

# Cobrança: Pix estático com confirmação manual do admin em /painel/assinaturas
PIX_CHAVE=
PIX_NOME=Seu Nome
PIX_CIDADE=Sua Cidade
ADMIN_WHATSAPP=5511999999999
# Primeiro pagamento (já inclui o primeiro período) e mensalidade, em reais, a cada PLANO_DIAS dias
PLANO_ADESAO=100
PLANO_VALOR=50
PLANO_DIAS=30
# Dias de uso antes do primeiro pagamento. 0 = só libera depois do Pix confirmado pelo admin.
PLANO_TESTE_DIAS=0

# Avisos no celular do barbeiro (opcional: sem isso, as chaves são geradas e guardadas no banco)
VAPID_PUBLICA=
VAPID_PRIVADA=
