# Modelo das variáveis do app de UM barbeiro (o SaaS é um app por barbearia na Square).
# O jeito fácil: no site de leads, /painel/assinaturas → linha da assinatura → "App do barbeiro":
# o bloco já vem preenchido (subdomínio, senha, até quando está pago, dados da barbearia).
# Na Square: Configurações → Variáveis de ambiente (dá pra importar este arquivo) e reinicie.
# O zip já vem com MODO_SITE=saas. Não tem venda, cobrança nem link pro site de leads.

# Endereço deste app (o subdomínio que você pôs na Square)
SITE_URL=https://barbearia-do-ze.squareweb.app

# Senha da página de admin do barbeiro (/admin). Só a senha, sem e-mail. Trocou? Quem estava
# logado sai na próxima vez que o app reiniciar.
PAINEL_SENHA=

# Seu WhatsApp: "Renovar pelo WhatsApp" do aviso de prazo e "Esqueceu a senha?"
ADMIN_WHATSAPP=5511999999999

# O app começa com PLANO_DIAS dias pagos. PAGO_ATE (AAAA-MM-DD) manda no prazo: renovou no site de
# leads, mude a data aqui e reinicie. Quando acaba, o painel só avisa; nada sai do ar.
PLANO_DIAS=30
PAGO_ATE=
# Só aparecem na página de Termos (use os mesmos do site de leads)
PLANO_ADESAO=100
PLANO_VALOR=50

# Dados iniciais do site (só na primeira vez que o app sobe; depois o barbeiro muda no painel)
BARBEARIA_NOME=Barbearia do Zé
BARBEARIA_WHATSAPP=5511999999999
BARBEIRO_NOME=Zé
BARBEARIA_CIDADE=
# silencioso, atemporal, cerimonia, tecnico, potencia ou extravagancia
BARBEARIA_ESTILO=cerimonia

# Texto aleatório pra embaralhar IP e e-mail nas travas contra abuso
BOT_SEGREDO=

# Avisos no celular do barbeiro (opcional: sem isso, as chaves são geradas e guardadas no banco)
VAPID_PUBLICA=
VAPID_PRIVADA=
