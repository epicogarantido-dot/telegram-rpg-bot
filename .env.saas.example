# Modelo de .env do app SaaS: o que é ENTREGUE a quem já pagou (site de cada barbearia, agenda e
# painel do barbeiro). Não tem venda, cobrança nem link pro site de leads: a compra e o Pix são lá.
# Você cria o site do cliente aqui em /painel/assinaturas ("Criar site de cliente") e manda o link
# e a senha no WhatsApp. Cada site começa com PLANO_DIAS dias; quando acaba, o painel só avisa.
# Copie pra .env no app das barbearias na Square. O zip já vem com MODO_SITE=saas.

# Endereço DESTE app
SITE_URL=https://sitedabarbearia.squareweb.app

# Senha do admin (/painel/assinaturas)
PAINEL_SENHA=

# Seu WhatsApp: botão "Renovar pelo WhatsApp" do aviso de prazo e "Esqueceu a senha?"
ADMIN_WHATSAPP=5511999999999

# Dias de cada período: o site novo começa com eles e "+N dias" soma mais um período
PLANO_DIAS=30
# O SaaS não cobra: estes dois só aparecem na página de Termos. Use os mesmos do app de leads.
PLANO_ADESAO=100
PLANO_VALOR=50

# Texto aleatório pra embaralhar IP e e-mail nas travas contra abuso (nunca vão puros pro banco)
BOT_SEGREDO=

# Avisos no celular do barbeiro (opcional: sem isso, as chaves são geradas e guardadas no banco)
VAPID_PUBLICA=
VAPID_PRIVADA=
