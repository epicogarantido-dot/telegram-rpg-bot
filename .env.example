# Tradução (scripts de ingestão)
ANTHROPIC_API_KEY=

# Site (o endereço DESTE app)
SITE_URL=http://localhost:3000

# Dois apps (leads e SaaS) ou um só. Cada zip já vem com o MODO_SITE certo:
# - o de leads MOSTRA E COBRA (exemplos, prévia, cadastro e o 1º Pix). SAAS_URL (endereço do app
#   SaaS) é opcional: manda pra lá quem abrir um link velho do painel;
# - o SaaS ENTREGA (site do cliente, agenda, painel e renovações) e não tem link nenhum pra cá
#   (modelo próprio: .env.saas.example). Você confirma o Pix no de leads e cria o site do cliente
#   no SaaS ("Criar site de cliente" em /painel/assinaturas), que abre o WhatsApp com link e senha.
# MODO_SITE=leads | saas
SAAS_URL=

# Prospecção: OpenStreetMap é o padrão e é grátis. Google é opcional (exige conta com cartão).
GOOGLE_MAPS_API_KEY=

# Painel /painel (sem senha o painel fica desligado)
PAINEL_SENHA=
REMETENTE=João, do Aprenda Livre
COMUNIDADE_LINK=https://chat.whatsapp.com/SEU-LINK
NICHO_PLURAL=barbeiros
LIMITE_DIARIO=20

# Bancos (opcional; padrão: data/privado/*.db)
# MEMBROS_DB=  AGENDA_DB=  PROSPECCAO_DB=  FOTOS_DIR=

# Cobrança: Pix estático com confirmação manual do admin em /painel/assinaturas.
# Preencha nos DOIS apps: o de leads cobra a contratação, o SaaS cobra as renovações.
PIX_CHAVE=
PIX_NOME=Seu Nome
PIX_CIDADE=Sua Cidade
ADMIN_WHATSAPP=5511999999999
# Contratação: valor do PRIMEIRO pagamento (já inclui o primeiro período). 0 = igual à mensalidade.
PLANO_ADESAO=100
# Mensalidade pra manter o site e a agenda, a cada PLANO_DIAS dias.
PLANO_VALOR=50
PLANO_DIAS=30
# Dias de uso antes do primeiro pagamento. 0 (padrão) = a conta só libera depois do Pix confirmado pelo admin.
PLANO_TESTE_DIAS=0

# Avisos no celular do barbeiro (opcional: sem isso, as chaves são geradas e guardadas no banco da agenda)
# Gere com: npx web-push generate-vapid-keys
VAPID_PUBLICA=
VAPID_PRIVADA=
