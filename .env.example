# Tradução (scripts de ingestão)
ANTHROPIC_API_KEY=

# Site / bot
SITE_URL=http://localhost:3000
# Número do bot (só dígitos com DDI). O site mostra "mande o código pra este WhatsApp".
BOT_WHATSAPP=5511999999999
# Segredo compartilhado entre bot e site (mesmo valor nos dois; mín. 24 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BOT_SEGREDO=
# Números (só dígitos, com DDI) que podem usar comandos de admin, separados por vírgula
BOT_ADMINS=5511999999999

# Prospecção: OpenStreetMap é o padrão e é grátis. Google é opcional (exige conta com cartão).
GOOGLE_MAPS_API_KEY=

# Painel /painel (sem senha o painel fica desligado)
PAINEL_SENHA=
REMETENTE=João, do Aprenda Livre
COMUNIDADE_LINK=https://chat.whatsapp.com/SEU-LINK
NICHO_PLURAL=barbeiros
LIMITE_DIARIO=20

# Bancos (opcional; padrão: data/privado/*.db)
# MEMBROS_DB=  AGENDA_DB=  PROSPECCAO_DB=

# Cobrança da agenda: Pix estático com confirmação manual do admin em /painel/assinaturas
PIX_CHAVE=
PIX_NOME=Seu Nome
PIX_CIDADE=Sua Cidade
ADMIN_WHATSAPP=5511999999999
PLANO_VALOR=29.90
PLANO_DIAS=30
# Dias grátis ao criar conta (0 = só usa depois de pagar e o admin confirmar)
PLANO_TESTE_DIAS=7
